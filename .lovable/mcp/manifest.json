            },
            "auto_publish": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "autopilot",
        "title": "Run autopilot",
        "description": "Run the end-to-end flow for a niche: scan, blueprint, channel, evergreen concepts. Use mode 'plan' to stop before rendering, 'full' to also render.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "niche": {
              "type": "string",
              "minLength": 1
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "channel_name": {
              "type": "string",
              "minLength": 1
            },
            "video_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "duration_target": {
              "type": "integer",
              "minimum": 8,
              "maximum": 120
            },
            "mode": {
              "default": "plan",
              "type": "string",
              "enum": [
                "plan",
                "full"
              ]
            }
          },
          "required": [
            "niche"
          ]
        },
        "outputSchema": null
