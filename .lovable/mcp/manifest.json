          },
          "required": [
            "channel_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "render_video",
        "title": "Render a generated video",
        "description": "Render the actual video file for a generated concept. Duration is in seconds (8-120).",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
